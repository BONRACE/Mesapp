# ──────────────────────────────────────────────────────────────────────────
# NovaTickets — variables d'environnement
# Copie ce fichier en ".env" (à la racine, à côté de manage.py) et remplis
# les valeurs. Le ".env" ne doit JAMAIS être partagé ni versionné (voir
# .gitignore) : il contient tes vraies clés secrètes.
# ──────────────────────────────────────────────────────────────────────────

# --- Django ---
# Génère une vraie clé secrète en production, par ex. :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=True
# Liste de domaines/IP séparés par des virgules en production, ex: novatickets.bj,www.novatickets.bj
DJANGO_ALLOWED_HOSTS=*

# URL publique du site (utilisée pour construire les liens de callback/webhook envoyés à
# FedaPay). En local, laisse tel quel. En production, mets l'URL réelle en HTTPS.
SITE_BASE_URL=http://127.0.0.1:8000

# --- FedaPay (passerelle de paiement) ---
# Clés à récupérer sur https://dashboard.fedapay.com (Développeurs > Clés API).
# Commence toujours par tester en "sandbox" avant de passer en "live".
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxxxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxx
# Secret du webhook : dashboard FedaPay > Développeurs > Webhooks > ton endpoint.
# URL à déclarer côté FedaPay : {SITE_BASE_URL}/billets/paiement/webhook/fedapay/
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- E-mail (reçus envoyés aux spectateurs) ---
# En local, laisse le backend "console" : les e-mails s'affichent dans le terminal au lieu
# d'être réellement envoyés. En production, décommente et configure un vrai SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=ta-cle-api-smtp
DEFAULT_FROM_EMAIL=NovaTickets <no-reply@novatickets.bj>
