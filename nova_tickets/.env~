# =====================================================================================================
#  NovaTickets — variables d'environnement
#  1) Copiez ce fichier en « .env » (cp .env.example .env)   2) Remplacez les valeurs d'exemple
#  3) Ne PUBLIEZ JAMAIS le fichier .env (mots de passe) : il est déjà dans .gitignore.
# =====================================================================================================

# --- Application ---------------------------------------------------------------------------------
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# --- E-mails (reçus de paiement, mot de passe oublié) -----------------------------------------------
# Envoi réel par SMTP. Pour ne rien envoyer en développement (e-mails écrits dans sent_emails/) :
#   EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre.adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-16-caracteres
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=NovaTickets <votre.adresse@gmail.com>

# Gmail : activez la validation en 2 étapes, puis créez un « mot de passe d'application » (16 caractères) sur
#   https://myaccount.google.com/apppasswords — c'est lui qu'il faut mettre dans EMAIL_HOST_PASSWORD
#   (jamais votre mot de passe Gmail habituel).
# Autres fournisseurs (exemples) :
#   Brevo (Sendinblue) : EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587  EMAIL_USE_TLS=True
#   Mailjet            : EMAIL_HOST=in-v3.mailjet.com      EMAIL_PORT=587  EMAIL_USE_TLS=True
#   Port 465 (SSL)     : EMAIL_PORT=465  EMAIL_USE_TLS=False  EMAIL_USE_SSL=True
# Tant que EMAIL_HOST_USER / EMAIL_HOST_PASSWORD gardent leurs valeurs d'exemple, l'envoi réel est désactivé.

# --- Mobile Money (MTN MoMo / Moov Money) ------------------------------------------------------------
MOMO_GATEWAY_MODE=simulation
MOMO_API_BASE_URL=
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=remplacez-par-un-secret-partage-long

# --- Paiement en ligne : FedaPay (https://fedapay.com) -------------------------------------------------
# PAYMENT_GATEWAY=fedapay active FedaPay pour les billets, les cartes de visite et l'abonnement organisateur.
# 1) Créez un compte sur https://app.fedapay.com puis copiez vos clés (Paramètres > Clés API).
# 2) Webhooks > Créer un endpoint : URL https://VOTRE-DOMAINE/paiement/webhook/ , événements transaction.* ;
#    copiez le secret « wh_… » obtenu dans FEDAPAY_WEBHOOK_SECRET.
# 3) Tests : FEDAPAY_ENV=sandbox + clé sk_sandbox_… ; production : FEDAPAY_ENV=live + clé sk_live_…
PAYMENT_GATEWAY=simulation
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CURRENCY=XOF

# --- Informations légales affichées dans les CGU -------------------------------------------------------
SUPPORT_EMAIL=contact@novatickets.app
LEGAL_COMPANY=NovaTickets — Cotonou, République du Bénin
