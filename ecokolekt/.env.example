# Copiez en .env puis adaptez. En production : DJANGO_DEBUG=0 (le serveur refuse de démarrer avec une config de démo).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-with-at-least-32-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=ecokolekt
POSTGRES_USER=ecokolekt
POSTGRES_PASSWORD=ecokolekt
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# SMS : console (démo, affiche le code) | http (agrégateur, voir accounts/otp.py)
SMS_BACKEND=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=EcoKolekt

# Paiements : mock (démo) | fedapay | cinetpay
PAYMENT_DEFAULT_PROVIDER=mock
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
MARKET_COMMISSION_RATE=0.05

# Routage : vide = estimation haversine ; sinon URL d'un serveur OSRM (ex. http://osrm:5000)
OSRM_URL=
AUTO_ASSIGN_RADIUS_M=6000
QR_MAX_DISTANCE_M=250
